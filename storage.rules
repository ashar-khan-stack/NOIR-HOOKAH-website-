rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true && 
        request.auth.token.role == 'ADMIN';
    }

    // Public catalog media (hookahs, flavors, menu items)
    // Read: anyone (public lounge browsing)
    // Write: authenticated Admins only
    match /catalog/{category}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Admin uploaded marketing media and banners
    match /admin/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 20 * 1024 * 1024;
    }

    // Member profile avatars & receipts
    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
