rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true && 
        request.auth.token.role == 'ADMIN';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (
          request.auth.uid == userId && 
          request.resource.data.role == 'USER' && 
          (request.resource.data.loyaltyPoints == 0 || !('loyaltyPoints' in request.resource.data))
        )
      );
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'loyaltyPoints', 'membershipTier'])
      );
      allow delete: if isAdmin();
    }

    // Public Catalogs: Hookahs, Flavors, Menu, Notifications
    match /hookahs/{hookahId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flavors/{flavorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if !('userId' in resource.data) || resource.data.userId == null || (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (notificationId == 'onboarding-' + request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.type == 'onboarding')
      );
      allow update, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Reservations Collection
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email || 
        (resource.data.userId != null && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Client Requests
    match /clientRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notification Read States per User
    match /notificationStates/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // System Errors Collection (Error Monitoring)
    match /systemErrors/{errorId} {
      // Error logs & direct Firestore access strictly confidential to verified Executive Admins.
      // Non-admin clients must ingest anomalies via the secure reportSystemErrorCallable function.
      allow read, write: if isAdmin();
    }

    // Admin FCM Push Notification Tokens
    match /adminFcmTokens/{tokenId} {
      // Restricted exclusively to verified Executive Admins managing their own registered tokens
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAdmin() && request.auth.uid == resource.data.userId;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
